# Public Supabase credentials only. Never put service_role, database
# passwords, or other secrets in VITE_* variables — Vite exposes them
# to the browser.
#
# Copy to .env.local and fill in values from the Supabase project:
# Settings → API → Project URL and anon / publishable key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
